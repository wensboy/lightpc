{
    "application": {
        "name": "lightpc",
        "description": "轻量级pc启动和构建工具",
        "window": {
            "width": 800,
            "height": 600
        }
    },
    "runtime": {
        "store": {
            "root": "~/.config/lightpc/",
            "fs": {
                "fileMode": "0o644",
                "dirMode": "0o755"
            }
        },
        "log": {
            "direct": [],
            "fanout":[
                {
                    "name": "dev.file",
                    "level": "debug",
                    "handler": "file",
                    "output": [
                        {
                            "serializer": {
                                "type": "json",
                                "enableSource": false
                            },
                            "path": "~/.config/lightpc/logs/debug.log",
                            "mode": "0o644"
                        }
                    ]
                },
                {
                    "name": "dev.console",
                    "level": "debug",
                    "handler": "console",
                    "output": [
                        {
                            "serializer": {
                                "type": "text",
                                "enableSource": true
                            },
                            "out": "stdout"
                        }
                    ]
                }
            ],
            "pattern": []
        }
    }
}