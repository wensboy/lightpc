{
    "application": {
        "name": "lightpc",
        "description": "轻量级pc启动和构建工具",
        "window": {
            "width": 800,
            "height": 600
        },
        "enableDevTools": true,
        "disableDefaultContextMenu": false
    },
    "runtime": {
        "engines": {
            "store": {
                "root": "local://~/.config/lightpc/",
                "fs": {
                    "fileMode": "0o644",
                    "dirMode": "0o755"
                },
                "db": {
                    "sql": [
                        {
                            "name": "dev_sqlite",
                            "driver": "sqlite3",
                            "skipped": false,
                            "dsn": "sqlite://~/.config/lightpc/db/dev.db",
                            "options": [
                                "_journal_mode=WAL",
                                "_synchronous=NORMAL",
                                "_busy_timeout=5000",
                                "_foreign_keys=OFF"
                            ],
                            "migrations": [
                                "embed://data/migrate/sqlite"
                            ]
                        },
                        {
                            "name": "dev_sqlite",
                            "driver": "sqlite3",
                            "skipped": false,
                            "dsn": "sqlite://~/.config/lightpc/db/dev_1.db",
                            "options": [
                                "_journal_mode=WAL",
                                "_synchronous=NORMAL",
                                "_busy_timeout=5000",
                                "_foreign_keys=OFF"
                            ],
                            "migrations": [
                                "embed://data/migrate/sqlite"
                            ]
                        },
                        {
                            "name": "dev_maria",
                            "driver": "mysql",
                            "skipped": true,
                            "dsn": "mysql://user:password@tcp(127.0.0.1:3306)/lightpc",
                            "options": [
                                "charset=utf8mb4",
                                "parseTime=true",
                                "loc=Local"
                            ],
                            "migrations": [
                                "embed://data/migrate/maria"
                            ]
                        }
                    ]
                }
            },
            "log": {
                "direct": [],
                "fanout": [
                    {
                        "name": "dev.file",
                        "level": "debug",
                        "handler": "file",
                        "output": [
                            {
                                "serializer": {
                                    "type": "json",
                                    "enableSource": false
                                },
                                "path": "local://~/.config/lightpc/logs/debug.log",
                                "mode": "0o644"
                            }
                        ]
                    },
                    {
                        "name": "dev.console",
                        "level": "debug",
                        "handler": "console",
                        "output": [
                            {
                                "serializer": {
                                    "type": "text",
                                    "enableSource": true
                                },
                                "path": "stdout"
                            }
                        ]
                    },
                    {
                        "name": "dev.db",
                        "level": "debug",
                        "handler": "database",
                        "output": [
                            {
                                "serializer": {
                                    "type": "json",
                                    "enableSource": false
                                },
                                "path": "sqlite3.dev_sqlite"
                            }
                        ]
                    }
                ],
                "pattern": []
            },
            "setting": {
                "schema": "embed://data/conf/schema/setting.schema.json",
                "layers": [
                    {
                        "layer": "default",
                        "path": "embed://data/conf/setting.default.json",
                        "mode": "ro"
                    },
                    {
                        "layer": "user",
                        "path": "local://~/.config/lightpc/setting.json",
                        "mode": "rw"
                    }
                ]
            },
            "notice": {
               "buf": 1024
            }
        },
        "services": {
            "softDelete": true,
            "docs": [
                "embed://data/docs/beta"
            ],
            "session": {
                "expiration": "7200 s"
            }
        }
    }
}
