{
    "application": {
        "name": "lightpc",
        "description": "轻量级pc启动和构建工具",
        "window": {
            "width": 800,
            "height": 600
        },
        "enableDevTools": true,
        "disableDefaultContextMenu": false
    },
    "runtime": {
        "store": {
            "root": "local://~/.config/lightpc/",
            "fs": {
                "fileMode": "0o644",
                "dirMode": "0o755"
            }
        },
        "log": {
            "direct": [],
            "fanout":[
                {
                    "name": "dev.file",
                    "level": "debug",
                    "handler": "file",
                    "output": [
                        {
                            "serializer": {
                                "type": "json",
                                "enableSource": false
                            },
                            "path": "local://~/.config/lightpc/logs/debug.log",
                            "mode": "0o644"
                        }
                    ]
                },
                {
                    "name": "dev.console",
                    "level": "debug",
                    "handler": "console",
                    "output": [
                        {
                            "serializer": {
                                "type": "text",
                                "enableSource": true
                            },
                            "out": "stdout"
                        }
                    ]
                }
            ],
            "pattern": []
        },
        "setting": {
            "schema": "embed://data/conf/schema/setting.schema.json",
            "layers": [
                {
                    "layer": "default",
                    "path": "embed://data/conf/setting.default.json",
                    "mode": "ro"
                },
                {
                "layer": "user",
                "path": "local://~/.config/lightpc/setting.json",
                "mode": "rw"
                }
            ]
        },
        "docs": [
            "embed://data/docs/beta"
        ]
    }
}