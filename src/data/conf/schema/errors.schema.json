{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://lightpc.local/schema/errors.schema.json",
    "title": "lightpc error definitions",
    "description": "Error groups loaded from data/conf/errors.json and flattened into a code to kind mapping.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version"
    ],
    "properties": {
        "version": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string"
        }
    },
    "patternProperties": {
        "^(?!version$)(?!description$).+$": {
            "$ref": "#/$defs/group"
        }
    },
    "$defs": {
        "group": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "definition"
            ],
            "properties": {
                "description": {
                    "type": "string"
                },
                "definition": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/definition"
                    }
                }
            }
        },
        "definition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "code",
                "kind"
            ],
            "properties": {
                "code": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "kind": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}
