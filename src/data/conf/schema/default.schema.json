{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://lightpc.local/schema/default.schema.json",
    "title": "lightpc application defaults",
    "description": "Default configuration loaded from data/conf/default.json.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "application",
        "runtime"
    ],
    "properties": {
        "application": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "description",
                "window"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string"
                },
                "window": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "width",
                        "height"
                    ],
                    "properties": {
                        "width": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "height": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                }
            }
        },
        "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "store",
                "log"
            ],
            "properties": {
                "store": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "root",
                        "fs"
                    ],
                    "properties": {
                        "root": {
                            "type": "string",
                            "minLength": 1
                        },
                        "fs": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "fileMode",
                                "dirMode"
                            ],
                            "properties": {
                                "fileMode": {
                                    "type": "string",
                                    "pattern": "^0o[0-7]{3}$"
                                },
                                "dirMode": {
                                    "type": "string",
                                    "pattern": "^0o[0-7]{3}$"
                                }
                            }
                        }
                    }
                },
                "log": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "direct": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/logItem"
                            }
                        },
                        "fanout": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/logItem"
                            }
                        },
                        "pattern": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/logItem"
                            }
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "logItem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "level",
                "handler",
                "output"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "level": {
                    "type": "string",
                    "enum": [
                        "debug",
                        "info",
                        "warn",
                        "warning",
                        "error"
                    ]
                },
                "handler": {
                    "type": "string",
                    "enum": [
                        "",
                        "file"
                    ]
                },
                "output": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/logOutput"
                        },
                        {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "$ref": "#/$defs/logOutput"
                            }
                        }
                    ]
                }
            }
        },
        "logOutput": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "serializer"
            ],
            "properties": {
                "serializer": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": [
                                "text",
                                "json"
                            ]
                        },
                        "enableSource": {
                            "type": "boolean"
                        }
                    }
                },
                "out": {
                    "type": "string",
                    "enum": [
                        "stdout",
                        "stderr"
                    ]
                },
                "path": {
                    "type": "string"
                },
                "mode": {
                    "type": "string",
                    "pattern": "^0o[0-7]{3}$"
                }
            }
        }
    }
}
