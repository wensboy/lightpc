# .env 作为唯一环境拓展加载进入 source 后被 config 接管.
# 一般格式: PREFIX_KEY=VALUE
# 调用时, 通常无须考虑 prefix, 并且 key 统一调用为: key1.key2.key3 形式, 
# 允许自定义 key 映射.

# project
LIGHTPC_AUTHOR="wendisx"
LIGHTPC_REPO="https://github.com/wensboy/lightpc.git"
LIGHTPC_LICENSE="MIT"
LIGHTPC_BUILD_BRANCH="main"

# runtime
LIGHTPC_RUNTIME_STORE_ROOT=