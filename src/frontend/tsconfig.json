{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Wails emits plain JS bindings with JSDoc types, so they are compiled alongside TS sources. */
    "allowJs": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noImplicitAny": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths: resolved against this file, so the deprecated baseUrl option is not needed. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "bindings", "vite.config.ts"]
}
